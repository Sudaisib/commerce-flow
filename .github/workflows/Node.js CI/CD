name: Node.js CI/CD

on:
  push:
    branches:
      - main
      - develop

  pull_request:
    branches:
      - main
      - develop

  workflow_dispatch:

env:
  APP_NAME: "My Node Application"
  NODE_DEFAULT_VERSION: "22"
  BUILD_ENVIRONMENT: "production"

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:

  build:
    name: Build - Node ${{ matrix.node-version }}

    runs-on: ${{ matrix.os }}

    timeout-minutes: 15

    strategy:
      matrix:
        node-version: [20, 22]
        os: [ubuntu-latest, windows-latest]

    steps:

      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Display variables
        run: |
          echo "Application: $APP_NAME"
          echo "Default Node Version: $NODE_DEFAULT_VERSION"
          echo "Environment: $BUILD_ENVIRONMENT"
          echo "Matrix Node Version: ${{ matrix.node-version }}"
          echo "Operating System: ${{ matrix.os }}"

      - name: Build application
        run: npm run build

      - name: Run tests
        run: npm test

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: build-node-${{ matrix.node-version }}-${{ matrix.os }}
          path: dist/


  deploy:
    name: Deploy Application

    runs-on: ubuntu-latest

    needs: build

    timeout-minutes: 30

    steps:

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts/

      - name: Display deployment information
        run: |
          echo "Application: $APP_NAME"
          echo "Environment: $BUILD_ENVIRONMENT"

      - name: Deploy application
        run: |
          echo "Deploying application..."
          echo "Deployment completed."
